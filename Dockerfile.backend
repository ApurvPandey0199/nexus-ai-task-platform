# ============================================================================
# Dockerfile: Node.js Express Backend REST API
# ============================================================================

FROM node:20-alpine
WORKDIR /app
COPY package*.json ./
RUN npm ci --only=production
COPY server/ ./server/
COPY src/ ./src/
COPY tsconfig.json ./
EXPOSE 3001
ENV NODE_ENV=production
CMD ["npx", "tsx", "server/index.ts"]
